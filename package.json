{
  "name": "ga-to-grok",
  "version": "0.6.1",
  "description": "Open-source MCP server connecting Google Analytics 4 + GTM/sGTM to Grok (xAI)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ga-to-grok": "./dist/index.js",
    "ga-to-grok-cli": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:http": "node dist/index.js --transport http",
    "cli": "tsx src/cli.ts",
    "cli:audit-web": "tsx src/cli.ts audit-web",
    "cli:audit-sgtm": "tsx src/cli.ts audit-sgtm",
    "cli:verify-secrets": "tsx src/cli.ts verify-secrets",
    "cli:suggest-mp": "tsx src/cli.ts suggest-mp",
    "cli:compare-dual": "tsx src/cli.ts compare-dual",
    "cli:cutover": "tsx src/cli.ts cutover-checklist",
    "cli:health": "tsx src/cli.ts health",
    "cli:observability": "tsx src/cli.ts observability",
    "cli:list-sgtm": "tsx src/cli.ts list-sgtm",
    "validate:ci": "bash scripts/ci-validate.sh",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "google-analytics",
    "ga4",
    "gtm",
    "sgtm",
    "grok",
    "xai",
    "model-context-protocol",
    "analytics"
  ],
  "author": "Geoffroy de La Tournelle <geoffroydelatournelle@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Geoking2104/GA-to-Grok.git"
  },
  "bugs": {
    "url": "https://github.com/Geoking2104/GA-to-Grok/issues"
  },
  "homepage": "https://github.com/Geoking2104/GA-to-Grok#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^9.14.0",
    "googleapis": "^144.0.0",
    "ioredis": "^5.4.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
