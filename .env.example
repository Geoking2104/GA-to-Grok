# Required for Service Account authentication
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or paste the JSON content directly (less secure)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# Default GA4 Property ID (optional if you always specify it in tools)
GA4_PROPERTY_ID=123456789

# Server configuration
PORT=3000
TRANSPORT=http          # http | stdio
HOST=0.0.0.0

# Optional: Redis cache (highly recommended in production)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:password@your-redis-host:6379

# Cache TTLs in seconds (optional)
# CACHE_TTL_REPORT=600        # 10 minutes
# CACHE_TTL_METADATA=3600     # 1 hour
# CACHE_TTL_PROPERTIES=1800   # 30 minutes

# Optional: restrict allowed properties (comma-separated)
# ALLOWED_PROPERTY_IDS=123456789,987654321

# Logging
LOG_LEVEL=info
