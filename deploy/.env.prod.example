# ─────────────────────────────────────────────────────────────────────────────
# Production environment for the VPS deployment (Docker + Caddy).
# Copy to deploy/.env.prod and fill in the values, then:
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d
# ─────────────────────────────────────────────────────────────────────────────

# Public site address. MUST be a domain with an A/AAAA record pointing to the
# VPS public IP (e.g. vps-OpenDPE.vps.ovh.net or your own subdomain).
# Let's Encrypt requires a resolvable public domain — a bare IP will NOT work.
SITE_ADDRESS=vps-OpenDPE.vps.ovh.net

# Email for the Let's Encrypt ACME account (cert issuance + renewal notices).
CADDY_EMAIL=you@example.com

# MCP bearer token. Grok Connectors / Remote MCP Tools send:
#   Authorization: Bearer <MCP_API_TOKEN>
# Generate a long random value, e.g. `openssl rand -hex 32`.
MCP_API_TOKEN=change-me-to-a-long-random-string

# Google service account JSON must be placed at deploy/service-account.json
# (mounted read-only into the container).

# Restrict to read-only by default; flip to "true" only if you need write tools.
GA4_WRITE_ENABLED=false
GTM_WRITE_ENABLED=false

# Optional default property (leave blank to require per-call propertyId).
GA4_PROPERTY_ID=

# Cache TTLs (seconds) and logging.
CACHE_TTL_REPORT=600
CACHE_TTL_METADATA=3600
LOG_LEVEL=info
